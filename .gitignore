# Build outputs, runs, caches, saves (pc-port/out also has its own .gitignore)
/pc-port/out/
/build/
/build-opt/
/build-sdl/
*.obj
*.exe
*.dll
*.pdb
*.lib
*.exp
**/__pycache__/
*.pyc

# Local dependencies (see README: Building)
/research/
/tools/

# Local data and leftovers
# Game dump (Sony): never commit or push
/CUSA00004/
/SaveBackup/
/sandbox/
/pc-port/evidence/
/Para deletar/
*.lnk

# Internal session notes (local only)
/docs/handoffs/
/docs/archive/
/docs/relocation-map.json
**/HANDOFF-*.md
*.antes-da-mudanca
/Jogar-*.cmd
# Game artwork (Sony): used by the local PowerShell launcher only
/launcher/assets/game.*
/docs/media/*.png
# Interface screenshots (the port's own windows, no game art) are kept.
!/docs/media/ui-*.png
!/docs/media/launcher-*.png
